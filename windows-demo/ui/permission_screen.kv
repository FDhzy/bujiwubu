<PermissionScreen>:
    canvas.before:
        Color:
            rgba: 0.07, 0.09, 0.12, 1  # Dark theme background
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(30)
        spacing: dp(20)

        Label:
            text: "权限及隐私说明"
            font_name: 'ChineseFont'
            font_size: sp(36)
            bold: True
            size_hint_y: 0.1
            color: 1, 1, 1, 1

        ScrollView:
            size_hint_y: 0.7
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(10)
                spacing: dp(15)
                
                Label:
                    text: "[b]权限使用说明[/b]"
                    markup: True
                    font_name: 'ChineseFont'
                    font_size: sp(22)
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1]
                    color: 1, 0.8, 0.4, 1

                Label:
                    text: "为了为您提供更安全、精准的避障服务，“避障助手”需要获取以下权限：\n\n1. 相机权限：用于检测前方路面的水坑和障碍物。\n\n2. 麦克风权限：用于语音指令识别和唤醒功能。\n\n3. 存储权限：用于保存您的个人偏好和鞋型设置。\n\n4. 震动权限：用于在紧急情况下通过触觉向您发出警报。"
                    font_name: 'ChineseFont'
                    font_size: sp(18)
                    line_height: 1.3
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1]
                    halign: 'left'
                    color: 0.9, 0.9, 0.9, 1

                Label:
                    text: "[b]隐私政策摘要[/b]"
                    markup: True
                    font_name: 'ChineseFont'
                    font_size: sp(22)
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1]
                    color: 1, 0.8, 0.4, 1

                Label:
                    text: "我们非常重视您的隐私。本软件所有核心识别逻辑（水坑检测、障碍物识别、语音指令）均在您的本地设备上运行。我们不会上传、存储或分享您的任何实时图像、音频数据或位置信息。相关偏好设置仅存储在本地 data 目录中。\n\n点击下方“确认”按钮，即表示您已阅读并同意上述权限使用说明及隐私政策。"
                    font_name: 'ChineseFont'
                    font_size: sp(18)
                    line_height: 1.3
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1]
                    halign: 'left'
                    color: 0.9, 0.9, 0.9, 1

        AccessibleButton:
            text: "确认"
            font_name: 'ChineseFont'
            font_size: sp(32)
            bold: True
            size_hint_y: 0.2
            background_color: 0.2, 0.6, 0.3, 1  # Greenish confirm button
            on_release: root.on_confirm()
